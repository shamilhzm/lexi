{
  "name": "lexi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lexi — a free, open-source German vocabulary terminal (A1–C2). FSRS spaced repetition over a deep lexicon, rendered as a live dictionary market. Local-first, donation-supported.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host --port 4318",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus:fetch": "node scripts/corpus/fetch.ts",
    "corpus:coverage": "node scripts/corpus/coverage.ts",
    "corpus:examples": "node scripts/corpus/examples.ts",
    "corpus:definitions": "node scripts/corpus/definitions.ts",
    "corpus:germandef": "node scripts/corpus/germandef.ts",
    "corpus:casefix": "node scripts/corpus/casefix.ts",
    "corpus:frontfix": "node scripts/corpus/frontfix.ts",
    "corpus:build": "node scripts/corpus/build.ts",
    "corpus:audio": "node scripts/corpus/audio.ts",
    "corpus:grammar": "node scripts/corpus/grammar-supplement.ts",
    "corpus:resector": "node scripts/corpus/resector.ts",
    "corpus:crosscheck": "node scripts/corpus/crosscheck.ts",
    "corpus:validate": "node scripts/corpus/validate.ts",
    "corpus:flags": "node scripts/corpus/flags.ts",
    "corpus:relevel": "node scripts/corpus/relevel.ts",
    "corpus:posfix": "node scripts/corpus/posfix.ts",
    "corpus:split": "node scripts/corpus/split.ts",
    "corpus:audit": "node scripts/corpus/audit.ts",
    "corpus:freq": "node scripts/corpus/freq.ts",
    "corpus:selftest": "node scripts/corpus/selftest.ts",
    "brain:mesh": "node scripts/brain/mesh.ts",
    "corpus:enrich": "node scripts/corpus/enrich-fields.ts",
    "authoring:input": "node scripts/authoring/make-input.ts",
    "authoring:apply": "node scripts/authoring/apply-authored.ts",
    "authoring:fix": "node scripts/authoring/fix-authored.ts",
    "lint": "eslint src",
    "corpus:relevel:a1": "node scripts/corpus/relevel-a1.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "ts-fsrs": "^5.4.1"
  }
}

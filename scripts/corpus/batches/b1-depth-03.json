  {
    "level": "B1",
    "title": "Zweiteilige Konjunktion: je … desto/umso",
    "exercises": [
      {
        "kind": "choose",
        "prompt": "___ mehr ich lerne, desto besser verstehe ich.",
        "options": [
          "Je",
          "Desto",
          "Umso"
        ],
        "answer": 0,
        "explain": "je opens the first half, desto or umso the second."
      },
      {
        "kind": "choose",
        "prompt": "Je länger ich warte, ___ ungeduldiger werde ich.",
        "options": [
          "desto",
          "je",
          "als"
        ],
        "answer": 0,
        "explain": "desto (or umso) introduces the main clause."
      },
      {
        "kind": "choose",
        "prompt": "Je mehr er ___, desto müder wurde er.",
        "options": [
          "arbeitete",
          "arbeitete er",
          "arbeiten"
        ],
        "answer": 0,
        "explain": "The je-clause is subordinate: the verb goes to the end."
      },
      {
        "kind": "choose",
        "prompt": "Je schneller du fährst, desto gefährlicher ___ es.",
        "options": [
          "wird",
          "es wird",
          "werden"
        ],
        "answer": 0,
        "explain": "The desto-clause is a main clause with inversion: desto + comparative + verb + subject."
      },
      {
        "kind": "choose",
        "prompt": "Je ___ Übung, desto besser das Ergebnis.",
        "options": [
          "mehr",
          "viel",
          "mehrere"
        ],
        "answer": 0,
        "explain": "Both halves need a comparative — that is the whole construction."
      },
      {
        "kind": "choose",
        "prompt": "Je weniger Zucker, ___ gesünder.",
        "options": [
          "umso",
          "je",
          "als"
        ],
        "answer": 0,
        "explain": "umso is a full synonym of desto."
      },
      {
        "kind": "mc",
        "prompt": "Wo steht das Verb im „je“-Teil?",
        "options": [
          "am Ende",
          "an Position 2",
          "an Position 1"
        ],
        "answer": 0,
        "explain": "je introduces a subordinate clause; desto introduces a main clause. The two halves have different word order, which is what makes this construction hard."
      },
      {
        "kind": "mc",
        "prompt": "Was muss in beiden Teilen stehen?",
        "options": [
          "ein Komparativ",
          "ein Modalverb",
          "eine Verneinung"
        ],
        "answer": 0,
        "explain": "je mehr … desto besser, je länger … desto schwieriger."
      }
    ]
  },

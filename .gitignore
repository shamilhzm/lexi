node_modules
dist
*.local
.DS_Store
.vercel

# Vite/Vitest write a transient timestamp module next to the config on each run.
*.timestamp-*.mjs

# Corpus pipeline: raw third-party dumps and intermediate reports are cached
# locally and never redistributed (only derived facts + attributed content ship).
scripts/corpus/data/

# Brain mesh pipeline: the ICBM152 grey-matter volume is fetched at build time
# and never redistributed. Only the derived mesh (public/data/brain-mesh.bin)
# ships — see docs/BRAIN.md and ATTRIBUTIONS.md.
scripts/brain/data/

# Local reference material (~260 MB: DaF textbook scans, design screenshots).
# Source for the A1/A2 corpus rebalance — see reference/DaF Wortschatz/MANIFEST.md
# and docs/archive/COHESION-PLAN.md Phase 3. Never committed, never redistributed.
reference/

# Authoring inputs are generated by scripts/authoring/make-input.ts, and empty
# fix/def batches by corpus:examples --write / corpus:definitions --write. Only
# *authored* batches are committed — those are the audit trail for what changed in
# the corpus and why; the rest is one command away.
scripts/authoring/batches/inputs/

# Transient storage write-probe.
.writetest

# Local editor/preview config (launch.json for the dev-server preview).
.claude/
